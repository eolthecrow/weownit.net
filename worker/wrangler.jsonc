{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "network-security-assistant",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "vars": {
    "CONTACT_FROM_EMAIL": "contact@weownit.net",
    "NEWSLETTER_FROM_EMAIL": "weownit.net <updates@weownit.net>",
    "RESEND_SEGMENT_EN": "f479b983-cfc6-4a7b-a9eb-03017b543e3c",
    "RESEND_SEGMENT_FR": "a828b8bb-94d5-42ce-b08d-0d7ad01b4788",
    "RESEND_SEGMENT_RO": "39483845-13c4-4744-9950-918368b31c1d"
  },
  "ai": {
    "binding": "AI"
  },
  // Per-IP abuse limits (Workers Rate Limiting). period must be 10 or 60 seconds.
  // namespace_id values must be unique integers within the Cloudflare account.
  "ratelimits": [
    { "name": "CHAT_LIMITER", "namespace_id": "4101", "simple": { "limit": 8, "period": 60 } },
    { "name": "CONTACT_LIMITER", "namespace_id": "4102", "simple": { "limit": 3, "period": 60 } },
    { "name": "CVE_LIMITER", "namespace_id": "4103", "simple": { "limit": 20, "period": 60 } },
    { "name": "EVENT_LIMITER", "namespace_id": "4104", "simple": { "limit": 30, "period": 60 } },
    { "name": "NEWSLETTER_LIMITER", "namespace_id": "4105", "simple": { "limit": 5, "period": 60 } }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "vladimir.arjoca@outlook.com",
      "allowed_sender_addresses": [
        "contact@weownit.net"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "SUBSCRIBERS_DB",
      "database_name": "weownit_subscribers",
      "database_id": "b381eda6-7b56-4770-82fd-d9e204022cc8"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      // Invocation logs record full request URLs, which include newsletter
      // confirm/unsubscribe tokens. Application logs (console.*) stay on.
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  }
}
