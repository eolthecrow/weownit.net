{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "weownit-store-live-checkout",
  "main": "src/live-public-index.js",
  "compatibility_date": "2026-10-21",
  "workers_dev": false,
  // Never expose this Worker on *.workers.dev preview URLs; serve only checkout.weownit.net.
  "preview_urls": false,
  // Per-client limits; the buyer Worker refuses checkout/recovery if these are missing.
  // namespace_id must be unique in the Cloudflare account (the site Worker uses 4101-4105).
  "ratelimits": [
    { "name": "LIVE_CHECKOUT_LIMITER", "namespace_id": "4201", "simple": { "limit": 5, "period": 60 } },
    { "name": "LIVE_RECOVERY_LIMITER", "namespace_id": "4202", "simple": { "limit": 3, "period": 60 } }
  ],
  "vars": {
    "LIVE_COMMERCIAL_SIGNOFF": "false",
    "LIVE_CHECKOUT_ENABLED": "false",
    "LIVE_WEBHOOK_ENABLED": "false",
    "LIVE_DELIVERY_ENABLED": "false",
    "LIVE_RECOVERY_ENABLED": "false",
    "LIVE_PUBLIC_CATALOG_ENABLED": "false",
    "LIVE_STORE_CONNECTED": "false",
    "LIVE_EXPECTED_ACCOUNT_ID": "REPLACE_WITH_REVIEWED_LIVE_STRIPE_ACCOUNT_ID",
    "LIVE_CHECKOUT_ORIGIN": "https://checkout.weownit.net"
  },
  "r2_buckets": [
    { "binding": "LIVE_TOOLKITS_R2", "bucket_name": "REPLACE_WITH_PRIVATE_LIVE_BUCKET" }
  ],
  "d1_databases": [
    {
      "binding": "LIVE_CATALOG_DB",
      "database_name": "REPLACE_WITH_ISOLATED_LIVE_D1_NAME",
      "database_id": "REPLACE_WITH_ISOLATED_LIVE_D1_UUID"
    }
  ]
}
